// Меры отчёта (таблица «Меры»). Данные учебные.

// ---- Страница «Сравнение КП» ----
// Сумма по позициям, цены которых взяты из КП (включая «КРУ под ключ» у Подрядчика Г)
По_КП_руб = CALCULATE(SUM(tVOR[Сумма_итог_руб]), tVOR[Источник суммы] = "По ценам КП")

// Сумма по позициям без цены в КП: справочная цена × объём ведомости
По_справочнику_руб = COALESCE(CALCULATE(SUM(tVOR[Сумма_итог_руб]), tVOR[Источник суммы] = "По справочным ценам (нет в КП)"), 0)

// Доля расчёта по справочным ценам в итоге подрядчика
Доля_справочных = DIVIDE([По_справочнику_руб], SUM(tVOR[Сумма_итог_руб]))

// Количество позиций ведомости без цены в КП
Позиций_нет_в_КП = COALESCE(CALCULATE(COUNTROWS(tVOR), tVOR[Источник суммы] = "По справочным ценам (нет в КП)"), 0)

// ---- Страница «Позиции для проверки» ----
Проверено_цен = COUNTROWS(KP_Clean)
Требуют_проверки = CALCULATE(COUNTROWS(KP_Clean), KP_Clean[Флаг] <> "в норме")
В_норме = CALCULATE(COUNTROWS(KP_Clean), KP_Clean[Флаг] = "в норме")
